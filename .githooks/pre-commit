#!/usr/bin/env bash
# .githooks/pre-commit
# IP protection checks + RAG re-index before each commit.
# Install with: make install-hooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

FAIL=0

# ── IP Protection Checks ────────────────────────────────────────────────

echo "[pre-commit] Running IP protection checks..."

# 1. Copyright header check — every staged .py file must have BSL 1.1 header
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' || true)
if [ -n "$STAGED_PY" ]; then
    MISSING=""
    for f in $STAGED_PY; do
        if [ -f "$f" ] && ! head -5 "$f" | grep -q "Licensed under the Business Source License 1.1"; then
            MISSING="$MISSING  $f\n"
        fi
    done
    if [ -n "$MISSING" ]; then
        echo "ERROR: Staged .py files missing BSL 1.1 copyright header:"
        echo -e "$MISSING"
        FAIL=1
    fi
fi

# 2. Trade secret language check — block staged files containing sensitive terms
#    Excludes .githooks/ (pattern definitions) and FORKS.md (fork documentation)
TRADE_SECRET_PATTERNS="monetization|pricing tier|revenue projection|marketplace funnel|IP valuation|commercial strategy"
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM || true)
if [ -n "$STAGED_ALL" ]; then
    for f in $STAGED_ALL; do
        case "$f" in .githooks/*|FORKS.md) continue ;; esac
        if [ -f "$f" ] && git diff --cached -- "$f" | grep -iEq "$TRADE_SECRET_PATTERNS"; then
            echo "ERROR: Trade secret language detected in staged diff of $f"
            FAIL=1
        fi
    done
fi

# 3. Monetization file guard — block monetization doc paths
if git diff --cached --name-only | grep -iEq "doc/monetization|doc/.*pricing|doc/.*revenue"; then
    echo "ERROR: Monetization/pricing/revenue documents must not be committed."
    FAIL=1
fi

# 4. Version drift check — pyproject.toml and src/__init__.py must match
if [ -f "pyproject.toml" ] && [ -f "src/__init__.py" ]; then
    V_PYPROJECT=$(grep -oP 'version\s*=\s*"\K[^"]+' pyproject.toml | head -1)
    V_INIT=$(grep -oP '__version__\s*=\s*"\K[^"]+' src/__init__.py | head -1)
    if [ -n "$V_PYPROJECT" ] && [ -n "$V_INIT" ] && [ "$V_PYPROJECT" != "$V_INIT" ]; then
        echo "ERROR: Version mismatch — pyproject.toml=$V_PYPROJECT vs src/__init__.py=$V_INIT"
        FAIL=1
    fi
fi

# 4b. LICENSE version must match pyproject.toml
if [ -f "LICENSE" ] && [ -f "pyproject.toml" ]; then
    V_PYPROJECT=$(grep -oP 'version\s*=\s*"\K[^"]+' pyproject.toml | head -1)
    V_LICENSE=$(grep -oP 'v\K[0-9]+\.[0-9]+\.[0-9]+' LICENSE | head -1)
    if [ -n "$V_PYPROJECT" ] && [ -n "$V_LICENSE" ] && [ "$V_PYPROJECT" != "$V_LICENSE" ]; then
        echo "ERROR: LICENSE version v$V_LICENSE does not match pyproject.toml=$V_PYPROJECT"
        FAIL=1
    fi
fi

# 4c. README badge version must match pyproject.toml
if [ -f "README.md" ] && [ -f "pyproject.toml" ]; then
    V_PYPROJECT=$(grep -oP 'version\s*=\s*"\K[^"]+' pyproject.toml | head -1)
    V_BADGE=$(grep -oP 'Version-\K[0-9]+\.[0-9]+\.[0-9]+' README.md | head -1)
    if [ -n "$V_PYPROJECT" ] && [ -n "$V_BADGE" ] && [ "$V_PYPROJECT" != "$V_BADGE" ]; then
        echo "ERROR: README badge version $V_BADGE does not match pyproject.toml=$V_PYPROJECT"
        FAIL=1
    fi
fi

# 5. BSL 1.1 license guard — LICENSE must contain BSL 1.1 identifier
if [ -f "LICENSE" ] && ! grep -q "Business Source License 1.1" LICENSE; then
    echo "ERROR: LICENSE file does not contain 'Business Source License 1.1'"
    FAIL=1
fi

# 6. NOTICE attribution guard — must reference chienchuanw
if [ -f "NOTICE" ] && ! grep -q "chienchuanw" NOTICE; then
    echo "ERROR: NOTICE file must contain chienchuanw upstream attribution"
    FAIL=1
fi

# 7. README attribution guard — must reference chienchuanw
if [ -f "README.md" ] && ! grep -q "chienchuanw" README.md; then
    echo "ERROR: README.md must contain chienchuanw attribution"
    FAIL=1
fi

if [ "$FAIL" -ne 0 ]; then
    echo "[pre-commit] IP protection checks FAILED. Commit blocked."
    exit 1
fi

echo "[pre-commit] IP protection checks passed."

# ── Ruff Lint Check ──────────────────────────────────────────────────────

if [ -n "$STAGED_PY" ]; then
    echo "[pre-commit] Running ruff lint check..."
    if ! uv run ruff check src/ tests/ rag/ 2>&1; then
        echo "[pre-commit] Ruff lint check FAILED. Fix with: uv run ruff check --fix src/ tests/ rag/"
        exit 1
    fi
    echo "[pre-commit] Ruff lint check passed."
fi

# ── RAG Re-index ─────────────────────────────────────────────────────────

echo "[RAG] Re-indexing changed files..."
uv run python scripts/rag_ingest.py --root . --ref worktree --provider zero

echo "[RAG] Index up to date."
