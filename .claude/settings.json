{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "attribution": {
        "commit": "Generated with Claude Code",
        "pr": "Generated with Claude Code\n\nCo-Authored-By: Claude <noreply@anthropic.com>"
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .githooks/md-version-reminder.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash .githooks/stop-git-check.sh"
                    }
                ]
            }
        ]
    }
}
