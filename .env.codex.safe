# Codex-safe local profile (non-live defaults)
# Copy to .env in agent sandboxes that should never target production consoles.

GMA_HOST=127.0.0.1
GMA_USER=
GMA_PASSWORD=
GMA_PORT=30001
GMA_SAFETY_LEVEL=read-only
GMA_TRANSPORT=stdio
LOG_LEVEL=INFO

# Auth/Rights/License: lowest safe starting point
GMA_SCOPE=tier:0
GMA_LICENSE_TIER=community

# Never set bypass flags in agent mode
# GMA_AUTH_BYPASS=1
# GMA_RIGHTS_BYPASS=1
# GMA_LICENSE_BYPASS=1

# Optional RAG provider tokens
GITHUB_MODELS_TOKEN=
OPENROUTER_API_KEY=
RAG_EMBED_MODEL=openai/text-embedding-3-small
RAG_EMBED_DIMENSIONS=1536
